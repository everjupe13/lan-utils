{
  "name": "@nearby/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chess": {
      "types": "./dist/chess.d.ts",
      "import": "./dist/chess.js"
    },
    "./person": {
      "types": "./dist/person.d.ts",
      "import": "./dist/person.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./file-policy": {
      "types": "./dist/file-policy.d.ts",
      "import": "./dist/file-policy.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
